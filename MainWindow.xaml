<Window x:Class="ScanCharSecExploit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScanCharSecExploit"
        mc:Ignorable="d"
        Title="ScanCharSec - Hidden Unicode Character Scanner" Height="650" Width="950"
        Background="#1E1E2E" WindowStartupLocation="CenterScreen"
        Icon="app.ico">
    <Window.Resources>
        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background" Value="#89B4FA"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#45475A"/>
                    <Setter Property="Foreground" Value="#6C7086"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button" x:Key="DangerButton" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#F38BA8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <!-- Path Selection -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PathTextBox" Grid.Column="0" Margin="0,0,8,0"
                     Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A"
                     FontSize="13" Padding="8,6" VerticalContentAlignment="Center"
                     Text="C:\Users\Tommy\source\repos"/>
            <Button Grid.Column="1" Content="📁 Browse" Style="{StaticResource ActionButton}"
                    Margin="0,0,8,0" Click="BrowseButton_Click"/>
            <Button x:Name="ScanButton" Grid.Column="2" Content="▶ Scan" Style="{StaticResource ActionButton}"
                    Click="ScanButton_Click"/>
        </Grid>

        <!-- Results DataGrid -->
        <DataGrid x:Name="ResultsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Extended"
                  Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A"
                  RowBackground="#313244" AlternatingRowBackground="#3B3D50"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#45475A"
                  HeadersVisibility="Column" CanUserResizeRows="False" FontSize="12">
            <DataGrid.ContextMenu>
                <ContextMenu Background="#313244" BorderBrush="#45475A">
                    <MenuItem Header="📋 Copy Decoded Preview" Click="CopyPreview_Click"
                              Foreground="#CDD6F4" FontSize="12"/>
                    <MenuItem Header="📋 Copy File Path" Click="CopyFilePath_Click"
                              Foreground="#CDD6F4" FontSize="12"/>
                    <Separator Background="#45475A"/>
                    <MenuItem Header="🗑 Remove Selected" Click="RemoveSelected_Click"
                              Foreground="#CDD6F4" FontSize="12"/>
                    <MenuItem Header="🗑 Remove All" Click="RemoveAll_Click"
                              Foreground="#CDD6F4" FontSize="12"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#45475A"/>
                    <Setter Property="Foreground" Value="#CDD6F4"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="BorderBrush" Value="#585B70"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="File Path" Binding="{Binding FilePath}" Width="*"/>
                <DataGridTextColumn Header="Hidden Bytes" Binding="{Binding HiddenByteCount}" Width="100"/>
                <DataGridTextColumn Header="Decoded Preview" Binding="{Binding DecodedPreview}" Width="250"/>
                <DataGridTextColumn Header="Base64 Decoded" Binding="{Binding Base64DecodedPreview}" Width="250"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Remove Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Right">
            <Button x:Name="RemoveSelectedButton" Content="🗑 Remove Selected" Style="{StaticResource DangerButton}"
                    Margin="0,0,8,0" Click="RemoveSelected_Click" IsEnabled="False"/>
            <Button x:Name="RemoveAllButton" Content="🗑 Remove All" Style="{StaticResource DangerButton}"
                    Click="RemoveAll_Click" IsEnabled="False"/>
        </StackPanel>

        <!-- Status Bar -->
        <Grid Grid.Row="3" Margin="0,8,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="#A6ADC8" FontSize="12"
                       VerticalAlignment="Center" Text="Ready"/>
            <ProgressBar x:Name="ScanProgress" Grid.Column="1" Width="200" Height="8"
                         Minimum="0" Maximum="100" Visibility="Collapsed"
                         Background="#45475A" Foreground="#89B4FA" BorderThickness="0"/>
        </Grid>

        <!-- Log Panel -->
        <Border Grid.Row="4" Background="#181825" CornerRadius="6" BorderBrush="#45475A" BorderThickness="1"
                Margin="0,4,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="📋 Logs" Foreground="#A6ADC8" FontSize="12"
                           FontWeight="SemiBold" Margin="8,6,8,4"/>
                <ScrollViewer Grid.Row="1" x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto"
                              Margin="8,0,8,8">
                    <TextBlock x:Name="LogTextBlock" Foreground="#BAC2DE" FontSize="11"
                               FontFamily="Cascadia Mono,Consolas,Courier New" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
